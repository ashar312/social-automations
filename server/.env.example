NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=social_automations
DB_USER=root
DB_PASSWORD=

# ── App ───────────────────────────────────────────
PORT=5000
HOST=127.0.0.1
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Public HTTPS base URL pointing at this server (cloudflared / ngrok). Instagram downloads media from it.
PUBLIC_BASE_URL=

# Generated locally. If you lose it, every account has to be reconnected.
TOKEN_ENCRYPTION_KEY=

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=4096
MEDIA_RETENTION_DAYS=7

# ── LinkedIn ──────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/oauth/linkedin/callback
LINKEDIN_API_VERSION=202611

# ── YouTube / Google ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/oauth/youtube/callback
YOUTUBE_AUDITED=false

# ── Meta (Facebook + Instagram) ───────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/oauth/meta/callback
META_GRAPH_VERSION=v24.0
META_WEBHOOK_VERIFY_TOKEN=

# Optional: full path to mysqldump if it is not on PATH (auto-detected on Windows)
MYSQLDUMP_PATH=
