NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=social_automations
DB_USER=root
DB_PASSWORD=

# ── App ───────────────────────────────────────────
PORT=5000
HOST=127.0.0.1
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Local HTTPS with mkcert (plans/06-local-https.md). Both empty = plain HTTP. Paths are relative to server/.
# When set, switch CLIENT_URL, SERVER_URL and the three *_REDIRECT_URI values to https://.
TLS_CERT_FILE=
TLS_KEY_FILE=
# TLS_CERT_FILE=../certs/localhost.pem
# TLS_KEY_FILE=../certs/localhost-key.pem

# Public HTTPS base URL pointing at this server (cloudflared / ngrok). Instagram downloads media from it.
PUBLIC_BASE_URL=
# true = other systems on the internet can call the external API (/api/v1) through that tunnel. See plans/guides/api.md
API_OVER_TUNNEL=false

# Generated locally. If you lose it, every account has to be reconnected.
TOKEN_ENCRYPTION_KEY=

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=4096
# Max PDF size for LinkedIn carousels (LinkedIn's own limit is 100 MB)
DOC_MAX_MB=100
MEDIA_RETENTION_DAYS=7

# ── LinkedIn ──────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/oauth/linkedin/callback
LINKEDIN_API_VERSION=202611
# true = let you pick a Company Page to post as (needs Community Management API product on the LinkedIn app)
LINKEDIN_ORG_POSTING=false

# ── YouTube / Google ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/oauth/youtube/callback
YOUTUBE_AUDITED=false

# ── Meta (Facebook + Instagram) ───────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/oauth/meta/callback
META_GRAPH_VERSION=v24.0
META_WEBHOOK_VERIFY_TOKEN=

# Optional: full path to mysqldump if it is not on PATH (auto-detected on Windows)
MYSQLDUMP_PATH=

# ── MCP server (/api/v1/mcp, see plans/05-mcp-server.md) ──
MCP_ENABLED=true
# Browser origins allowed to call the MCP endpoint (comma list). Empty = native clients only.
MCP_ALLOWED_ORIGINS=
# Max size of upload_media_base64 (MB)
MCP_MAX_INLINE_MB=10
# Folders upload_media_from_path may read (comma list). Empty = that tool is not offered.
MCP_ALLOWED_DIRS=
# Per-key limits
MCP_RATE_PER_MIN=60
MCP_POSTS_PER_HOUR=20

# ── Auth (plans/08-user-accounts-auth.md) ─────────
SESSION_DAYS=30
# Only during the user-scope migration, then delete the line
OWNER_PASSWORD=
AUTH_LINKEDIN_ENABLED=true
AUTH_LINKEDIN_REDIRECT_URI=http://localhost:5000/api/auth/linkedin/callback
AUTH_FACEBOOK_ENABLED=false
AUTH_FACEBOOK_REDIRECT_URI=http://localhost:5000/api/auth/facebook/callback
AUTH_INSTAGRAM_ENABLED=false
AUTH_INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/auth/instagram/callback
# Set true when deployed for other people (UI routes are behind login)
UI_REMOTE_ACCESS=false

# ── Email (SMTP) ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Social Automations
# Instagram sign-in (own app: Instagram API with Instagram Login; Business/Creator accounts only)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── Email engine (plans/09-email-engine.md) ───────
EMAIL_ENGINE_ENABLED=true
# Signs unsubscribe and feedback links. Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_LINK_SECRET=
EMAIL_BATCH=10
EMAIL_MAX_PER_MINUTE=20
EMAIL_MAX_PER_DAY=450
# Local hour for the daily summary (0-23)
EMAIL_DIGEST_HOUR=9
# Days without activity before the "we miss you" email
EMAIL_INACTIVE_DAYS=4
# Dev: true = log emails to the console instead of sending
EMAIL_DRY_RUN=false
