{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "db:create": "sequelize db:create --charset utf8mb4 --collate utf8mb4_unicode_ci",
    "db:migrate": "sequelize db:migrate",
    "db:migrate:undo": "sequelize db:migrate:undo",
    "start": "node --use-system-ca src/server.js",
    "dev": "nodemon --watch src --watch .env --exec \"node --use-system-ca\" src/server.js",
    "mcp:stdio": "node --use-system-ca bin/mcp-stdio.js",
    "db:backup": "node -e \"require('./src/services/backup').runBackup().then(f=>console.log(f)).catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^190.0.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
